{
  "name": "resume",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "start": "next start",
    "lint": "next lint",
    "test:seo": "node --test tests/seo.test.cjs",
    "test:navigation": "node --test tests/header.test.cjs tests/links.test.cjs",
    "test:analytics": "node --test tests/analytics.test.cjs",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "date-fns": "^3.6.0",
    "next": "15.5.29",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.6.0",
    "rehype-highlight": "^7.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
